[
  {
    "id": "customer-required",
    "type": "required",
    "path": "customerCode",
    "severity": "error",
    "message": "Customer code is required."
  },
  {
    "id": "known-customer",
    "type": "oneOf",
    "path": "customerCode",
    "values": ["ACME", "NORD", "GREEN", "DWF", "BHC"],
    "severity": "error",
    "message": "Customer code must exist in the customer list."
  },
  {
    "id": "reference-required",
    "type": "required",
    "path": "reference",
    "severity": "error",
    "message": "Reference is required before export."
  },
  {
    "id": "reference-max-length",
    "type": "maxLength",
    "path": "reference",
    "value": 16,
    "severity": "warning",
    "message": "Reference should be short enough for the export system."
  },
  {
    "id": "pickup-date-required",
    "type": "required",
    "path": "pickupDate",
    "severity": "error",
    "message": "Pickup date is required."
  },
  {
    "id": "pickup-date-format",
    "type": "date",
    "path": "pickupDate",
    "format": "iso",
    "severity": "error",
    "message": "Pickup date must use YYYY-MM-DD."
  },
  {
    "id": "delivery-postcode-required",
    "type": "required",
    "path": "addresses.delivery.postcode",
    "severity": "error",
    "message": "Delivery postcode is required."
  },
  {
    "id": "postcode-basic-shape",
    "type": "regex",
    "path": "addresses.delivery.postcode",
    "pattern": "^[A-Z0-9][A-Z0-9 -]{2,10}$",
    "severity": "warning",
    "message": "Delivery postcode looks unusual."
  },
  {
    "id": "weight-number",
    "type": "number",
    "path": "weightKg",
    "severity": "error",
    "message": "Weight must be numeric."
  },
  {
    "id": "weight-positive",
    "type": "min",
    "path": "weightKg",
    "value": 1,
    "severity": "error",
    "message": "Weight must be greater than zero."
  },
  {
    "id": "weight-max",
    "type": "max",
    "path": "weightKg",
    "value": 25000,
    "severity": "warning",
    "message": "Orders above 25,000 kg need manual capacity review."
  },
  {
    "id": "pallets-positive",
    "type": "min",
    "path": "pallets",
    "value": 1,
    "severity": "error",
    "message": "At least one pallet is required."
  },
  {
    "id": "service-level-known",
    "type": "oneOf",
    "path": "serviceLevel",
    "values": ["standard", "temperature_controlled", "express"],
    "severity": "warning",
    "message": "Service level is not recognized."
  },
  {
    "id": "temperature-known",
    "type": "oneOf",
    "path": "temperature",
    "values": ["ambient", "chilled", "frozen"],
    "severity": "warning",
    "message": "Temperature must be ambient, chilled, or frozen."
  },
  {
    "id": "temperature-controlled-needs-temperature",
    "type": "required",
    "path": "temperature",
    "severity": "error",
    "message": "Temperature-controlled orders need a temperature value.",
    "when": { "path": "serviceLevel", "equals": "temperature_controlled" }
  }
]
